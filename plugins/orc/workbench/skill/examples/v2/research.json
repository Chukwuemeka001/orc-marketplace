{
  "workbench_brief": 2,
  "goal": "Find out what a semantic-version string may contain.",
  "phase": {
    "name": "research",
    "objective": "Record the semver grammar rules, each with a source."
  },
  "later_phases": [],
  "criteria": [
    {
      "id": "c1",
      "text": "notes/semver.md lists the grammar rules and each bullet cites a source."
    }
