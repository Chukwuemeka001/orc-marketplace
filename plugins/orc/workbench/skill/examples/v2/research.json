  "decisions": [
    {
      "id": "d1",
      "question": "Which spec version?",
      "choice": "semver 2.0.0",
      "reversibility": "hard",
      "status": "decided"
    }
  ],
  "policy": {
    "retry_budget_per_node": 2,
    "max_parallel": 2,
    "ping": "failures_only",
    "caps": {
